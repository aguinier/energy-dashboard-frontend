# Local dev environment for the API server (`npm run dev`).
#
# Copy this file to `server/.env` (gitignored) and set ENERGY_DB_PATH to the
# absolute path of your local energy_dashboard.db. The dev server loads
# `server/.env` automatically via `tsx watch --env-file-if-exists=.env`.
#
# NOT used in Docker/production: there ENERGY_DB_PATH comes from the container
# (docker/.env -> docker-compose.yml), and the server runs the built bundle
# (`npm start`), which does not read this file.
#
# Path is machine-specific. On the able workstation the replica lives here:
ENERGY_DB_PATH=C:/Code/able/data/energy_dashboard.db

# Base URL of the OTHER environment's dashboard API, for GET /api/ops/status/combined
# (ABL-238's acceptance/prod status page). Prod's peer is acceptance and
# acceptance's peer is prod — set the one this process is NOT running as.
# Unset means "not configured": the status page shows that distinctly from an
# unreachable peer, and does not attempt an outbound request. In Docker/production
# this comes from docker/.env -> docker-compose.yml, same as ENERGY_DB_PATH above.
# OPS_PEER_URL=http://192.168.86.36:3001
