# Copy to .env.local (gitignored) to override the dev server's /api proxy.
#
# Unset (default) -> http://localhost:3001, i.e. the local API server started by
# `npm run dev`, which needs a local SQLite DB (see server/.env.example).
#
# Point it at another backend to run the client without a local database.
# The acceptance environment proxies the local dashboard Docker container on
# the workstation's LAN address (.237 = CAT workstation, NOT .36 which is prod):
# API_PROXY_TARGET=http://192.168.86.237:3001
#
# See WORKFLOWS.md ("API proxy on CAT") for the authoritative address — keep
# the environment-specific value in your gitignored .env.local, not here.
#
# NOTE: with API_PROXY_TARGET set, the locally running API server is bypassed,
# so local server-side changes will NOT be exercised. To test those, run the
# local server on a different port (PORT=3002) and point this at that instead.
API_PROXY_TARGET=http://localhost:3001
