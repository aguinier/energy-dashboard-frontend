# Copy to .env.local (gitignored) to override the dev server's /api proxy.
#
# Unset (default) -> http://localhost:3001, i.e. the local API server started by
# `npm run dev`, which needs a local SQLite DB (see server/.env.example).
#
# Point it at another backend to run the client without a local database. The
# workstation acceptance environment uses prod's API this way:
# API_PROXY_TARGET=http://192.168.86.36:3001
#
# NOTE: with this set, the locally running API server is bypassed, so local
# server-side changes will NOT be exercised. Unset it to test those.
API_PROXY_TARGET=http://localhost:3001
