# Path to the directory containing energy_dashboard.db
DB_DIR=/path/to/directory/containing/energy_dashboard.db

# Base URL of the OTHER environment's dashboard API, for the ABL-238
# acceptance/prod status page (GET /api/ops/status/combined). Prod's
# docker/.env sets this to acceptance's address; acceptance's sets it to
# prod's. Unset means "not configured" — the status page shows that
# distinctly from an unreachable peer.
# OPS_PEER_URL=http://192.168.86.237:3001
